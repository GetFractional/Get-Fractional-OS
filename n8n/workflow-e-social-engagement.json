          "Platform Comment ID": "={{ $node['Idempotency Key + CTA Detection'].json.comment_id }}",
          "Idempotency Key": "={{ $node['Idempotency Key + CTA Detection'].json.idempotencyKey }}",
          "CTA Keyword Detected": "={{ $node['Idempotency Key + CTA Detection'].json.ctaKeywordDetected }}",
          "Auto-Captured": true,
          "Status": "={{ $node['Idempotency Key + CTA Detection'].json.statusOverride }}"
        }
      },
      "id": "create-engagement",
